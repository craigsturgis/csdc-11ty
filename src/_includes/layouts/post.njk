---
layout: base.njk
permalink: "/{{ page.fileSlug }}/"
---

<article class="max-w-prose mx-auto px-4 sm:px-6 py-8">
    <header class="mb-8">
        <h1 class="text-3xl sm:text-5xl font-bold mb-2 text-paper">{{ title }}</h1>

        <div class="text-fog mb-4">
            <time datetime="{{ page.date | htmlDateString }}">
                {{ page.date | readableDate }}
            </time>
            {% if tags %}
                <div class="mt-2">
                    {% for tag in tags %}
                        {% if tag != "posts" %}
                            <span class="inline-block border border-white/15 px-3 py-1 text-sm font-semibold text-fog mr-2 mb-2">#{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </header>

    <div class="prose prose-lg prose-invert max-w-none prose-a:text-mint">
        {{ content | safe }}
    </div>
    {% from "macros/email-signup.njk" import emailSignup %}

    {{ emailSignup("Get more posts like this in your inbox") }}

    <footer class="mt-16 pt-8 border-t border-white/15">
        <nav class="flex justify-between">
            {%- set previousPost = collections.posts | getPreviousCollectionItem %}
            {%- set nextPost = collections.posts | getNextCollectionItem %}

            <div>
                {% if previousPost %}
                    <a href="{{ previousPost.url }}" class="text-mint hover:text-paper">
            ← {{ previousPost.data.title }}
                    </a>
                {% endif %}
            </div>

            <div>
                {% if nextPost %}
                    <a href="{{ nextPost.url }}" class="text-mint hover:text-paper">
                        {{ nextPost.data.title }} →
          </a>
                {% endif %}
            </div>
        </nav>
    </footer>
</article>
