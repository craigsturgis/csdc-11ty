{% macro emailSignup(labelText = "Subscribe to get updates when I write something new") %}
    <div class="mt-8 max-w-md mx-auto">
        <form
            action="https://buttondown.com/api/emails/embed-subscribe/craigsturgis"
            method="post"
            target="popupwindow"
            onsubmit="window.open('https://buttondown.com/craigsturgis', 'popupwindow')"
            class="embeddable-buttondown-form border border-white/15 bg-white/[0.025] p-6 space-y-4"
        >
            <div class="flex flex-col space-y-2">
                <label for="bd-email" class="text-lg text-center">{{ labelText }}</label>
                <input 
                    type="email" 
                    name="email" 
                    id="bd-email"
                    class="border border-white/25 bg-ink px-4 py-2 text-paper focus:outline-none focus:ring-2 focus:ring-mint"
                    placeholder="Enter your email"
/>
            </div>

            <div class="flex justify-center">
                <input 
                    type="submit" 
                    value="Subscribe" 
                    class="button-primary cursor-pointer"
/>
            </div>

            <p class="text-sm text-fog text-center">
                <a 
                    href="https://buttondown.com/refer/craigsturgis" 
                    target="_blank"
                    class="hover:underline"
                >
                    Powered by Buttondown.
                </a>
            </p>
        </form>
    </div>
{% endmacro %}
