---
layout: base.njk
title: Blog Posts
permalink: /posts/
---

<div class="mx-auto max-w-4xl">
    <p class="eyebrow mb-4">Archive of ideas</p>
    <h1 class="text-5xl font-semibold tracking-[-0.05em] sm:text-7xl">Writing</h1>

    {% from "macros/post-card.njk" import postCard %}

    {% if collections.posts %}
        <div class="mt-12 space-y-6">
            {%- for post in collections.posts | reverse -%}
                <div class="editorial-card">{{ postCard(post) }}</div>
            {%- endfor -%}
        </div>
    {% else %}
        <p>No posts yet.</p>
    {% endif %}

    <div class="mt-10 text-center">
        <a href="/archive/" class="button-secondary">View complete archive →</a>
    </div>
</div>
